# ---------------------------------------------------------------------------
# The Lenny Growth Assistant — environment configuration
# Copy this file to `.env` and fill in what you need. Safe defaults are set
# so the app runs fully on the local Ollama path with no cloud keys at all.
# NEVER commit your real .env file.
# ---------------------------------------------------------------------------

# --- Database (required) ---
# Matches the `db` service in docker-compose.yml. Change only if you point
# the backend at an external Postgres instance instead.
DATABASE_URL=postgresql+psycopg://lenny:lenny@db:5432/lenny_growth_assistant

# --- LLM provider toggle (required) ---
# One of: ollama | anthropic | openai
# This is the "flexible LLM configuration" switch — change it (or override
# at runtime via POST /api/config) without touching application code.
LLM_PROVIDER=ollama

# --- Ollama (local, mandatory for the demo) ---
# host.docker.internal lets the backend container reach Ollama running on
# your host machine. If Ollama runs elsewhere, change this URL.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# --- Anthropic (optional cloud provider) ---
# Leave blank to skip. If LLM_PROVIDER=anthropic and this is empty/invalid,
# the backend logs a warning and automatically falls back to Ollama.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- OpenAI (optional cloud provider) ---
# Same fallback behavior as Anthropic above.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Knowledge base ---
# Path to the folder containing sources.json + transcripts/. The Docker image
# mounts the repo's data/ dir at /app/data (see docker-compose.yml); if you
# run the backend outside Docker, point this at the repo's data/ folder.
DATA_DIR=/app/data

# --- App / server ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
